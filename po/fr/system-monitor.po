#: extension.js:79
msgid ""
"Dependencies Missing\n"
"Please install: \n"
"gnome-system-monitor and libgtop, clutter and Network Manager gir bindings \n"
"\t    on Debian and Ubuntu: gir1.2-gtop-2.0, gir1.2-nm-1.0, gir1.2-"
"clutter-1.0, gnome-system-monitor \n"
"\t    on Fedora: libgtop2-devel, NetworkManager-libnm-devel, gnome-system-"
"monitor \n"
"\t    on Arch: libgtop, networkmanager, gnome-system-monitor\n"
"\t    on openSUSE: typelib-1_0-GTop-2_0, typelib-1_0-NetworkManager-1_0, "
"gnome-system-monitor \n"
"\t    on Mageia 64-bit: lib64gtop-gir2.0, lib64nm-gir1.0, lib64clutter-"
"gir1.0, gnome-system-monitor\n"
msgstr ""
"Dépendances manquantes\n"
"\n"
"Veuillez installer gnome-system-monitor et les bibliothèques de liaisons gir "
"pour libclutter, libgtop et Network Manager :\n"
"\t- sur Debian et Ubuntu : gir1.2-gtop-2.0, gir1.2-nm-1.0, gir1.2-"
"clutter-1.0 et gnome-system-monitor ;\n"
"\t- sur Fedora : libgtop2-devel, NetworkManager-libnm-devel et gnome-system-"
"monitor ;\n"
"\t- sur Arch Linux : libgtop, networkmanager et gnome-system-monitor ;\n"
"\t- sur openSUSE : typelib-1_0-GTop-2_0, typelib-1_0-NetworkManager-1_0 et "
"gnome-system-monitor ;\n"
"\t- sur Mageia 64-bit : lib64gtop2-gir2.0, lib64nm-gir1.0, lib64clutter-"
"gir1.0 et gnome-system-monitor.\n"

